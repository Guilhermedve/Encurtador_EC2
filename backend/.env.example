PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY=false

NODE_ENV=development
LINK_REPOSITORY=memory
AZURE_STORAGE_TABLE_NAME=links
# AZURE_STORAGE_ACCOUNT_URL is required with azure-table outside Azurite.
# AZURE_STORAGE_CONNECTION_STRING is accepted only for local/CI Azurite tests.
